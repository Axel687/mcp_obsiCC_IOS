# Copy to .env on the VPS and fill in. Never commit .env.

# Domain pointing at the VPS (e.g. a subdomain you own). Caddy gets the certificate.
MCP_DOMAIN=mcp.example.com

# Password asked on the login page when you connect Claude. 12+ characters.
# Generate one with:  openssl rand -base64 18
OBSIDIAN_MCP_PASSWORD=

# Optional: static bearer token for Claude Code (claude mcp add --header ...).
# Generate with:  openssl rand -hex 32   — leave empty to disable.
OBSIDIAN_MCP_TOKEN=

# The private GitHub repo holding the vault (the same one Obsidian Git uses).
OBSIDIAN_VAULT_REMOTE=https://github.com/<you>/<vault-repo>.git
# Fine-grained GitHub token limited to that repo, permission "Contents: read and write".
OBSIDIAN_GIT_TOKEN=
OBSIDIAN_GIT_NAME=Claude (obsidian-mcp)
OBSIDIAN_GIT_EMAIL=obsidian-mcp@users.noreply.github.com

# Seconds between automatic pulls before tool calls (0 = before every call).
OBSIDIAN_PULL_INTERVAL=30

# Runs arbitrary Python on the server. Leave off unless you need it.
OBSIDIAN_ENABLE_GRAPHS=false
