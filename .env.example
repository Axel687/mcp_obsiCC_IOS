# Copy to .env on the VPS and fill in. Never commit .env.

# Domain pointing at the VPS (e.g. a subdomain you own). Caddy gets the certificate.
MCP_DOMAIN=mcp.example.com

# Password asked on the login page when you connect Claude. 12+ characters.
# Generate one with:  openssl rand -base64 18
OBSIDIAN_MCP_PASSWORD=

# Optional: static bearer token for Claude Code (claude mcp add --header ...).
# Generate with:  openssl rand -hex 32   — leave empty to disable.
OBSIDIAN_MCP_TOKEN=

# The private GitHub repo holding the vault (the same one Obsidian Git uses).
OBSIDIAN_VAULT_REMOTE=https://github.com/<you>/<vault-repo>.git
# Fine-grained GitHub token limited to that repo, permission "Contents: read and write".
# With extra vaults, give the same token access to their repos too.
OBSIDIAN_GIT_TOKEN=
OBSIDIAN_GIT_NAME=Claude (obsidian-mcp)
OBSIDIAN_GIT_EMAIL=obsidian-mcp@users.noreply.github.com

# Optional: more vaults, as name=repo pairs separated by ";". Names: lowercase letters,
# digits, - and _. Each one is cloned into /data/vaults/<name> and synced like the main
# vault. Tools take a `vault` parameter; changes must name the vault explicitly as soon
# as there is more than one. The main vault is called OBSIDIAN_VAULT_NAME (default
# "principal").
# OBSIDIAN_EXTRA_VAULTS=cours=https://github.com/<you>/<cours-repo>.git;perso=https://github.com/<you>/<perso-repo>.git
# OBSIDIAN_VAULT_NAME=principal

# Seconds between automatic pulls before tool calls (0 = before every call).
OBSIDIAN_PULL_INTERVAL=30

# Runs arbitrary Python on the server. Leave off unless you need it.
OBSIDIAN_ENABLE_GRAPHS=false

# YouTube often blocks requests from cloud servers. If youtube_transcript reports
# a block, route it through a proxy: http://user:pass@host:port
# OBSIDIAN_YOUTUBE_PROXY=

# Free YouTube Data API v3 key for youtube_search_videos (Google Cloud console).
# Restrict it to this server's IP and to the YouTube Data API v3.
# OBSIDIAN_YOUTUBE_API_KEY=

# Experimental search_x tool (twscrape). Unofficial scraping, against X's terms: use a
# DEDICATED X account, never your main one; X may lock or suspend it. Copy the cookies
# auth_token and ct0 from a browser where that account is logged in. Same username as
# OBSIDIAN_X_INBOX_ACCOUNT if left empty.
# OBSIDIAN_X_SEARCH_COOKIES=auth_token=...; ct0=...
# OBSIDIAN_X_SEARCH_ACCOUNT=
